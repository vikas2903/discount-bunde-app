# Shopify app credentials (copy from the Shopify Partner Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_discounts,read_orders,read_products,read_themes,write_discounts

# The exact public HTTPS URL supplied by the running Railway service.
SHOPIFY_APP_URL=https://your-app.up.railway.app
SHOPIFY_APP_HANDLE=

# Production billing: real recurring $10 charges after the 14-day trial.
# Set this to true only for a Shopify development or test store.
SHOPIFY_BILLING_TEST=false
SHOPIFY_SKIP_BILLING=false
NODE_ENV=production

# Use a Railway Volume mounted at /data, or replace this with a managed DB.
# Shopify sessions must persist across restarts for auth and billing returns.
DATABASE_URL=file:/data/dev.sqlite
