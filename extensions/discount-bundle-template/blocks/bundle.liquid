submit {width:100%;min-height:48px;border:0;border-radius:999px;background:var(--bundle-text);color:#fff;font-size:14px;font-weight:800;cursor:pointer;transition:opacity 0.2s ease,transform 0.2s ease} .bundle-collection__card-toggle{border-top-right-radius:0;border-top-left-radius:0} .bundle-collection__card-toggle {min-height:40px;background:#040000;color:#fff;border:1px solid var(--bundle-border);border-radius:6px;display:block;width:100%;max-width:100%;border-top-right-radius:0;border-top-left-radius:0;text-transform:capitalize} .bundle-collection__card.is-selected .bundle-collection__card-toggle {background:var(--bundle-accent);border-color:var(--bundle-accent);color:#fff} .bundle-collection__cta[disabled],.bundle-collection__modal-submit[disabled] {opacity:0.45;cursor:not-allowed} .bundle-collection__summary {position:sticky;top:24px} .bundle-collection__summary-card {background:rgba(255,255,255,0.94);border:1px solid var(--bundle-border);border-radius:10px;padding:10px 12px;box-shadow:var(--bundle-shadow)} .bundle-collection__status {margin:6px 0 8px;padding:6px 14px;border-radius:10px;background:var(--bundle-accent-soft);border:1px solid var(--bundle-accent);font-size:13px;font-weight:700} .bundle-collection__progress {margin:0 0 16px;padding:10px 14px;border-radius:16px;background:#fff;border:1px solid var(--bundle-border)} .bundle-collection__progress-steps {display:grid;{% if show_offer_2_fixed and show_offer_3_fixed %} grid-template-columns:repeat(3,1fr);{% elsif show_offer_2_fixed %} grid-template-columns:repeat(2,1fr);{% else %} grid-template-columns:repeat(3,1fr);{% endif %} gap:10px;margin-bottom:8px} .bundle-collection__progress-steps span {display:flex;align-items:center;justify-content:center;min-height:38px;border-radius:999px;border:1px solid var(--bundle-border);background:#f8f5ef;color:var(--bundle-muted);font-size:13px;font-weight:800} .bundle-collection__progress-steps span.is-active {background:var(--bundle-accent);border-color:var(--bundle-accent);color:#fff} .bundle-collection__progress-text {margin:0;font-size:12px;color:var(--bundle-muted);text-align:center} .bundle-collection__selected {display:grid;gap:10px;margin-bottom:16px} .bundle-collection__selected-track {display:contents} .bundle-collection__selected-empty,.bundle-collection__selected-item {border-radius:16px;border:1px dashed var(--bundle-border);padding:10px 14px;background:rgba(255,255,255,0.76)} .bundle-collection__selected-item {display:flex;align-items:center;justify-content:space-between;gap:12px;border-style:solid} .bundle-collection__selected-main {display:flex;align-items:center;gap:12px;min-width:0} .bundle-collection__selected-thumb {flex:0 0 52px;width:52px;height:52px;border-radius:12px;object-fit:cover;background:#f4efe8;display:block} .bundle-collection__selected-copy {min-width:0} .bundle-collection__selected-copy strong,.bundle-collection__selected-side strong {display:block;font-size:14px;color:var(--bundle-text)} .bundle-collection__selected-copy p {margin:4px 0 0;color:var(--bundle-muted);font-size:12px} .bundle-collection__selected-side {flex:0 0 auto;text-align:right} .bundle-collection__selected-remove {border:0;background:transparent;color:var(--bundle-accent);font-size:12px;font-weight:700;cursor:pointer;padding:0} .bundle-collection__selected-slot {display:none;align-items:center;justify-content:center;width:52px;height:52px;border-radius:14px;border:1px dashed var(--bundle-border);background:#fff;color:var(--bundle-muted);font-size:24px;font-weight:800} .bundle-collection__totals {display:grid;gap:12px;margin-bottom:16px} .bundle-collection__total-row {font-size:14px;color:var(--bundle-muted)} .bundle-collection__total-row strong {color:var(--bundle-text);font-size:15px} .bundle-collection__total-row--highlight {padding:14px 16px;border-radius:16px;background:#fff;border:1px solid var(--bundle-accent)} .bundle-collection__total-row--savings strong {color:var(--bundle-accent)} .bundle-collection__fineprint {marg