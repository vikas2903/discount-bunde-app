_modal-copy {display:grid;gap:8px} .bundle-collection__modal-price {margin:0;color:var(--bundle-text);font-size:18px;font-weight:800} .bundle-collection__option-group {display:grid;gap:10px} .bundle-collection__option-title {margin:0;color:var(--bundle-muted);font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase} .bundle-collection__option-values {display:flex;flex-wrap:wrap;gap:10px} .bundle-collection__variant-chip {border:1px solid var(--bundle-border);border-radius:999px;background:#fff;color:var(--bundle-text);min-height:42px;padding:10px 16px;font-size:13px;font-weight:700;cursor:pointer} .bundle-collection__variant-chip.is-selected {border-color:var(--bundle-accent);background:var(--bundle-accent-soft)} .bundle-collection__variant-chip[disabled] {opacity:0.45;cursor:not-allowed} @media (max-width:1024px) {.bundle-collection {padding-bottom:140px} .bundle-collection__shell {grid-template-columns:1fr} .bundle-collection__summary {position:fixed;left:10px;right:10px;bottom:10px;top:auto;z-index:30;margin:0} .bundle-collection__summary-card {display:grid;grid-template-columns:minmax(0,1fr) minmax(150px,190px);gap:10px 12px;align-items:center;max-width:680px;margin-left:auto;margin-right:auto;padding:12px 14px;border-radius:16px;box-shadow:0 10px 24px rgba(17,24,39,0.12)} .bundle-collection__summary-title,.bundle-collection__summary-copy,.bundle-collection__offers,.bundle-collection__progress,.bundle-collection__fineprint,.bundle-collection__total-row:nth-child(2),.bundle-collection__total-row:nth-child(3) {display:none} .bundle-collection__status {grid-column:1 / -1;margin:0;padding:0;border:0;background:transparent;color:var(--bundle-text);font-size:12px;line-height:1.3} .bundle-collection__selected {margin:0;min-width:0} .bundle-collection__selected-track {display:flex;align-items:center;gap:8px;min-width:0;justify-content:center} .bundle-collection__selected-empty {width:100%;border-style:solid;font-size:12px;text-align:center;padding:10px 12px} .bundle-collection__selected-item {border:0;padding:0;background:transparent;gap:0;position:relative} .bundle-collection__selected-main {gap:0} .bundle-collection__selected-copy {display:none} .bundle-collection__selected-side {position:absolute;top:-6px;right:-6px;display:flex;align-items:center;justify-content:center;z-index:1} .bundle-collection__selected-side strong {display:none} .bundle-collection__selected-remove {display:inline-flex;align-items:center;justify-content:center;width:10px;height:10px;min-width:10px;padding:7px;border-radius:999px;border:0;background:rgba(17,24,39,0.9);color:transparent;cursor:pointer;box-shadow:0 4px 12px rgba(15,23,42,0.24);font-size:0} .bundle-collection__selected-remove::before {content:'x';color:#fff;font-size:14px;font-weight:700;line-height:1;position:absolute} .bundle-collection__selected-thumb,.bundle-collection__selected-slot {width:42px;height:42px;flex-basis:42px;border-radius:10px} .bundle-collection__selected-slot {display:flex;font-size:18px} .bundle-collection__totals {gap:4px;margin:0} .bundle-collection__total-row {font-size:12px} .bundle-collection__total-row strong {font-size:13px} .bundle-collection__total-row--highlight {padding:0;border:0;background:transparent;border-radius:0} .bundle-collection__cta {grid-column:2;min-height:42px;border-radius:12px;font-size:13px;padding:10px 14px}} @media (max-width:768px) {.bundle-collection {padding-top:24px;padding-bottom:132px;padding-left:0;padding-right:0} .bundle-collection__title {font-size:24px} .bundle-collection__shell {gap:18px} .bundle-collection__grid {grid-template-columns:repeat(2,minmax(0,1fr))} .bundle-collection__summary-card {grid-template-columns:1fr;max-width:none} .bundle-collection__totals,.bundle-collection__cta {grid-column:auto} .bundle-collection__summary-card {gap:10px;padding:12px;border-radius:16px;box-shadow:0 18px 42px rgba(17,24,39,0.18)} .bundle-collection__status {font-size:12px} .bundle-collection__selected-track {gap:6px;overflow-x:auto;padding-bottom:2px;padding-top:8px;} .bundle-collection__selected-thumb,.bundle-collection__selected-slot {width:40px;height:40px;flex-basis:40px} .bundle-collection__totals {gap:6px} .bundle-collection__total-row {font-size:12px} .bundle-collection__total-row strong {font-size:14px} 
  
  .bundle-collection__card-price-row {
    justify-content: flex-start;
    padding: 2px 2px 0px;
}
.bundle-collection__card-price {
    font-size: 12px;
    font-weight: 500;
    padding: 0 2px;
}
.bundle-collection__card-title {

    font-size: 13px;

}
  .bundle-collection__cta {min-height:40px} .bundle-collection__modal-product {grid-template-columns:1fr} .bundle-collection__modal-media {max-width:180px}}</style>

  <style>
    .bundle-collection__card-badge--sold-out {
      background: #b42318;
    }

    .bundle-collection__card:has(.bundle-collection__card-badge--sold-out) {
      opacity: 0.72;
    }

    .bundle-collection__card-toggle[aria-disabled="true"] {
      cursor: not-allowed;
      opacity: 0.55;
    }

    @media (min-width: 1025px) {
      .bundle-collection__summary {
        height: calc(100dvh - 48px);
        overflow: hidden;
      }

      .bundle-collection__summary-card {
        height: 100%;
        max-height: calc(100dvh - 48px);
        overflow-y: auto;
        overscroll-behavior: contain;
      }

      .bundle-collection__cta {
        position: sticky;
        bottom: 0;
        z-index: 1;
        box-shadow: 0 -10px 18px rgba(255, 255, 255, 0.94);
      }
    }
  </style>

  <script>
    (() => {
      const section = document.querySelector('.bundle-collection--{{ block.id }}');
      if (!section) return;

      const checkoutMode = section.dataset.checkoutMode || 'shopify';
      const shopifyCheckoutLabel = section.dataset.shopifyCheckoutLabel || 'Checkout securely';
      const customCheckoutScriptTemplate = section.dataset.customCheckoutScript || '';
      const customCheckoutLabel = section.dataset.checkoutLabel || 'Custom checkout';
      const onePerVariant = section.dataset.onePerVariant === 'true';
      const bundleTiersValue = section.dataset.bundleTiers || '[]';
      const shopRoot = section.dataset.shopRoot || '/';
      const shopUrl = section.dataset.shopUrl || window.location.origin;
      const currencyCode = section.dataset.currencyCode || 'USD';

      let cards = Array.from(section.querySelectorAll('[data-bundle-card]'));
      const grid = section.querySelector('.bundle-collection__grid');
      const offerOptions = section.querySelector('[data-offer-options]');
      const paginationCopy = section.querySelector('.bundle-collection__pagination-copy');
      const loadMoreButton = section.querySelector('[data-load-more]');
      const regularTotalEl = section.querySelector('[data-regular-total]');
      const submitButton = section.querySelector('[data-bundle-submit]');
      const selectedList = section.querySelector('[data-selected-list]');
      const progressText = section.querySelector('[data-progress-text]');
      const bundleStatus = section.querySelector('[data-bundle-status]');
      const modal = section.querySelector('[data-variant-modal]');
      const modalTitle = section.querySelector('[data-modal-product-title]');
      const modalImage = section.querySelector('[data-modal-product-image]');
      const modalPrice = section.querySelector('[data-modal-product-price]');
      const modalOptions = section.querySelector('[data-modal-options]');
      const modalSubmit = section.querySelector('[data-modal-submit]');
      const modalCloseButtons = Array.from(section.querySelectorAll('[data-modal-close]'));

      const selectedItems = [];
      let modalContext = null;
      let modalVariants = [];
      let modalOptionNames = [];
      let modalSelection = {};
      let pendingVariant = null;
      let bundleTiers = [];
      const totalProducts = Number(section.dataset.totalProducts || cards.length);

      const formatMoney = (amountInCents) => {
        return new Intl.NumberFormat(undefined, {
          style: 'currency',
          currency: currencyCode
        }).format((Number(amountInCents) || 0) / 100);
      };

      const createLineId = () => Math.random().toString(36).slice(2, 10);
      const escapeHtml = (value) => String(value ?? '').replace(/[&<>'"]/g, (character) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
      })[character]);
      const getCheckoutButtonLabel = () => {
        return selectedItems.length
          ? (checkoutMode === 'custom' ? customCheckoutLabel : shopifyCheckoutLabel)
          : 'Select products';
      };

      const parseBundleTiers = () => {
        try {
          const tiers = JSON.parse(bundleTiersValue);
          bundleTiers = (Array.isArray(tiers) ? tiers : [])
            .filter((tier) => tier && tier.enabled !== false)
            .map((tier) => ({
              quantity: Number(tier.quantity),
              discountType: tier.discountType === 'fixed_price' ? 'fixed_price' : 'percentage',
              value: Number(tier.value)
            }))
            .filter((tier) => Number.isInteger(tier.quantity) && tier.quantity >= 2 && tier.value > 0)
            .sort((left, right) => left.quantity - right.quantity);
        } catch (error) {
          bundleTiers = [];
        }
      };

      const getTierLabel = (tier) => tier.discountType === 'fixed_price'
        ? 'Buy ' + tier.quantity + ' for ' + formatMoney(tier.value * 100)
        : 'Buy ' + tier.quantity + ' & save ' + tier.value + '%';

      const getQualifiedTier = () => bundleTiers
        .filter((tier) => selectedItems.length >= tier.quantity)
        .at(-1) || null;

      const getBundleLimit = () => bundleTiers.length
        ? Math.max(...bundleTiers.map((tier) => tier.quantity))
        : Infinity;

      const renderOfferOptions = () => {
        if (!offerOptions) return;
        offerOptions.innerHTML = bundleTiers.map((tier) => {
          const isQualified = selectedItems.length >= tier.quantity;
          return '<div class="bundle-collection__offer-option' + (isQualified ? ' is-active' : '') + '"><span>'
            + escapeHtml(getTierLabel(tier)) + '</span></div>';
        }).join('');
      };

      const getProductSelectedCount = (productId) => {
        return selectedItems.filter((item) => item.productId === productId).length;
      };

      const updatePaginationText = () => {
        if (!paginationCopy) return;
        paginationCopy.textContent = 'Showing 1-' + cards.length + ' of ' + totalProducts + ' products.';
      };

      const setLoadMoreState = (nextUrl) => {
        if (!loadMoreButton) return;

        loadMoreButton.dataset.nextUrl = nextUrl || '';
        loadMoreButton.hidden = !nextUrl;
        loadMoreButton.disabled = false;
        loadMoreButton.textContent = 'Load more products';
      };

      const getVariantDisplayTitle = (variant) => {
        const parts = [variant.option1, variant.option2, variant.option3].filter(Boolean);
        if (parts.length) return parts.join(' / ');
        return variant.title || 'Default';
      };

      const matchesSelection = (variant, selection) => {
        return [1, 2, 3].every((index) => {
          const key = 'option' + index;
          if (!selection[key]) return true;
          return variant[key] === selection[key];
        });
      };

      const findVariantFromSelection = () => {
        return modalVariants.find((variant) => variant.available && matchesSelection(variant, modalSelection))
          || modalVariants.find((variant) => matchesSelection(variant, modalSelection))
          || null;
      };

      const getAvailableValuesForIndex = (optionIndex) => {
        const key = 'option' + optionIndex;
        const values = [];

        modalVariants.forEach((variant) => {
          const partialSelection = { ...modalSelection };
          delete partialSelection[key];

          if (matchesSelection(variant, partialSelection) && !values.includes(variant[key])) {
            values.push(variant[key]);
          }
        });

        return values.filter(Boolean);
      };

      const syncModalSelectionUi = () => {
        Array.from(modalOptions.querySelectorAll('[data-option-index]')).forEach((button) => {
          const optionIndex = button.dataset.optionIndex;
          const optionValue = button.dataset.optionValue;
          const key = 'option' + optionIndex;
          const availableValues = getAvailableValuesForIndex(Number(optionIndex));
          const isAvailable = availableValues.includes(optionValue);
          const isSelected = modalSelection[key] === optionValue;

          button.classList.toggle('is-selected', isSelected);
          button.disabled = !isAvailable;
        });

        pendingVariant = findVariantFromSelection();
        modalSubmit.disabled = !pendingVariant || !pendingVariant.available;
        modalPrice.textContent = pendingVariant ? formatMoney(pendingVariant.price) : '';
      };

      const renderModalOptionGroups = () => {
        modalOptions.innerHTML = '';

        modalOptionNames.forEach((name, index) => {
          const optionIndex = index + 1;
          const values = [];

          modalVariants.forEach((variant) => {
            const value = variant['option' + optionIndex];
            if (value && !values.includes(value)) values.push(value);
          });

          if (!values.length) return;

          const groupMarkup = `
            <div class="bundle-collection__option-group">
              <p class="bundle-collection__option-title">${escapeHtml(name)}</p>
              <div class="bundle-collection__option-values">
                ${values.map((value) => `
                  <button
                    type="button"
                    class="bundle-collection__variant-chip"
                    data-option-index="${optionIndex}"
                    data-option-value="${String(value).replace(/"/g, '&quot;')}"
                  >
                    ${escapeHtml(value)}
                  </button>
                `).join('')}
              </div>
            </div>
          `;

          modalOptions.insertAdjacentHTML('beforeend', groupMarkup);
        });

        syncModalSelectionUi();
      };

      const bindCardInteractions = (card) => {
        const toggle = card.querySelector('[data-card-toggle]');
        if (!toggle || toggle.dataset.bound === 'true') return;

        toggle.dataset.bound = 'true';
        toggle.addEventListener('click', () => {
          if (card.dataset.productAvailable !== 'true') {
            progressText.textContent = 'This product is currently out of stock.';
            return;
          }

          if (selectedItems.length >= getBundleLimit()) {
            progressText.textContent = 'This bundle already has the maximum of ' + getBundleLimit() + ' items.';
            return;
          }

          if (card.dataset.hasMultipleVariants === 'true') {
            openModal(card);
            return;
          }

          commitSelection({
            productId: Number(card.dataset.productId),
            productTitle: card.dataset.productTitle,
            image: card.dataset.productImage,
            variantId: Number(card.dataset.defaultVariantId),
            variantTitle: card.dataset.defaultVariantTitle,
            price: Number(card.dataset.defaultPrice || 0)
          });
        });
      };

      const syncCards = () => {
        cards.forEach((card) => {
          const productId = Number(card.dataset.productId);
          const toggle = card.querySelector('[data-card-toggle]');
          const hasVariants = card.dataset.hasMultipleVariants === 'true';
          const isAvailable = card.dataset.productAvailable === 'true';
          const selectedCount = getProductSelectedCount(productId);

          if (!toggle) return;

          card.classList.toggle('is-selected', selectedCount > 0);
          toggle.setAttribute('aria-pressed', selectedCount > 0 ? 'true' : 'false');
          if (!isAvailable) {
            toggle.textContent = 'Out of stock';
            toggle.disabled = true;
            toggle.setAttribute('aria-disabled', 'true');
            return;
          }
          if (selectedItems.length >= getBundleLimit()) {
            toggle.textContent = 'Bundle full';
            toggle.disabled = true;
            toggle.setAttribute('aria-disabled', 'true');
            return;
          }
          if (onePerVariant && !hasVariants && selectedCount > 0) {
            toggle.textContent = 'Already added';
            toggle.disabled = true;
            return;
          }
          toggle.disabled = false;
          if (hasVariants) {
            toggle.textContent = selectedCount > 0 ? '+ Add one more' : 'Choose options';
          } else {
            toggle.textContent = selectedCount > 0 ? '+ Add one more' : 'Add to bundle';
          }
        });
      };

      const renderSelected = () => {
        if (!selectedItems.length) {
          selectedList.innerHTML = '<div class="bundle-collection__selected-empty">Your selected products will appear here.</div>';
          return;
        }

        const itemsMarkup = selectedItems.map((item) => `
          <div class="bundle-collection__selected-item">
            <div class="bundle-collection__selected-main">
              ${item.image ? `<img class="bundle-collection__selected-thumb" src="${escapeHtml(item.image)}" alt="${escapeHtml(item.productTitle)}">` : '<div class="bundle-collection__selected-thumb"></div>'}
              <div class="bundle-collection__selected-copy">
                <strong>${escapeHtml(item.productTitle.slice(0, 24))}..</strong>
                <p>${escapeHtml(item.variantTitle)}</p>
              </div>
            </div>
            <div class="bundle-collection__selected-side">
              <strong>${formatMoney(item.price)}</strong>
              <button type="button" class="bundle-collection__selected-remove" data-remove-line="${item.lineId}">Remove</button>
            </div>
          </div>
        `).join('');

        selectedList.innerHTML = `
          <div class="bundle-collection__selected-track">
            ${itemsMarkup}
          </div>
        `;
      };

      const updateSummary = () => {
        const regularTotal = selectedItems.reduce((sum, item) => sum + item.price, 0);
        const qualifiedTier = getQualifiedTier();

        regularTotalEl.textContent = formatMoney(regularTotal);
        if (selectedItems.length) {
          const tierMessage = qualifiedTier
            ? getTierLabel(qualifiedTier) + ' selected. Shopify calculates the final discount in cart.'
            : 'Add more items to qualify for one of your configured offers.';
          progressText.textContent = selectedItems.length + ' item' + (selectedItems.length === 1 ? '' : 's') + ' selected. ' + tierMessage;
          bundleStatus.textContent = selectedItems.length + ' item' + (selectedItems.length === 1 ? '' : 's') + ' selected.';
        } else {
          progressText.textContent = 'Select products and quantities to add them to your bundle.';
          bundleStatus.textContent = 'Select the products and quantities you want in your bundle.';
        }

        submitButton.disabled = selectedItems.length === 0;
        submitButton.textContent = getCheckoutButtonLabel();
        renderOfferOptions();
      };

      const commitSelection = (item) => {
        if (selectedItems.length >= getBundleLimit()) {
          progressText.textContent = 'This bundle already has the maximum of ' + getBundleLimit() + ' items.';
          return;
        }

        if (onePerVariant && selectedItems.some((selectedItem) => selectedItem.variantId === item.variantId)) {
          progressText.textContent = 'Only one of each variant can be added to this bundle.';
          return;
        }

        selectedItems.push({
          ...item,
          lineId: createLineId()
        });

        syncCards();
        renderSelected();
        updateSummary();
      };

      const resetSelection = () => {
        selectedItems.splice(0, selectedItems.length);
        syncCards();
        renderSelected();
        updateSummary();
      };

      const openModal = (card) => {
        const variantsJson = card.querySelector('[data-product-variants]');
        const optionsJson = card.querySelector('[data-product-options]');
        if (!variantsJson) return;

        modalContext = card;
        pendingVariant = null;
        modalTitle.textContent = card.dataset.productTitle || '';
        if (modalImage) {
          modalImage.src = card.dataset.productImage || '';
          modalImage.alt = card.dataset.productTitle || '';
        }

        try {
          modalVariants = JSON.parse(variantsJson.textContent);
        } catch (error) {
          modalVariants = [];
        }

        try {
          modalOptionNames = JSON.parse(optionsJson.textContent);
        } catch (error) {
          modalOptionNames = [];
        }

        const firstAvailable = modalVariants.find((variant) => variant.available) || modalVariants[0] || null;
        modalSelection = {};

        if (firstAvailable) {
          modalSelection.option1 = firstAvailable.option1 || '';
          modalSelection.option2 = firstAvailable.option2 || '';
          modalSelection.option3 = firstAvailable.option3 || '';
        }

        renderModalOptionGroups();
        modal.hidden = false;
        document.body.classList.add('overflow-hidden');
      };

      const closeModal = () => {
        modal.hidden = true;
        modalOptions.innerHTML = '';
        modalSubmit.disabled = true;
        if (modalImage) {
          modalImage.removeAttribute('src');
          modalImage.alt = '';
        }
        if (modalPrice) {
          modalPrice.textContent = '';
        }
        modalContext = null;
        pendingVariant = null;
        modalVariants = [];
        modalOptionNames = [];
        modalSelection = {};
        document.body.classList.remove('overflow-hidden');
      };

      const loadMoreProducts = async () => {
        if (!grid || !loadMoreButton) return;

        const nextUrl = loadMoreButton.dataset.nextUrl;
        if (!nextUrl) return;

        loadMoreButton.disabled = true;
        loadMoreButton.textContent = 'Loading...';

        try {
          const response = await fetch(nextUrl, {
            headers: {
              Accept: 'text/html'
            }
          });

          if (!response.ok) {
            throw new Error('Unable to load more products');
          }

          const html = await response.text();
          const parsedDocument = new DOMParser().parseFromString(html, 'text/html');
          const nextSection = parsedDocument.querySelector('.bundle-collection--{{ block.id }}');
          const nextGrid = nextSection?.querySelector('.bundle-collection__grid');

          if (!nextGrid) {
            throw new Error('Missing bundle grid');
          }

          const newCards = Array.from(nextGrid.querySelectorAll('[data-bundle-card]'));
          newCards.forEach((card) => {
            grid.appendChild(card);
            cards.push(card);
            bindCardInteractions(card);
          });

          const nextLoadMore = nextSection.querySelector('[data-load-more]');
          setLoadMoreState(nextLoadMore?.dataset.nextUrl || '');
          updatePaginationText();
          syncCards();
        } catch (error) {
          loadMoreButton.disabled = false;
          loadMoreButton.textContent = 'Try again';
        }
      };

      const applyTemplateTokens = (template, bundlePrice, regularTotal) => {
        const variantIds = selectedItems.map((item) => item.variantId).join(',');
        const replacements = {
          '{{shop_url}}': shopUrl,
          '{{shop_root}}': shopRoot,
          '{{checkout_url}}': shopRoot + 'checkout',
          '{{cart_url}}': shopRoot + 'cart',
          '{{bundle_total}}': String(bundlePrice / 100),
          '{{regular_total}}': String(regularTotal / 100),
          '{{discount_percent}}': '0',
          '{{bundle_size}}': String(selectedItems.length),
          '{{variant_ids}}': variantIds
        };

        return Object.keys(replacements).reduce((content, token) => {
          return content.split(token).join(replacements[token]);
        }, template || '');
      };

      const runCustomCheckout = (bundlePrice, regularTotal) => {
        if (!customCheckoutScriptTemplate) {
          window.location.href = shopRoot + 'checkout';
          return;
        }

        const processedTemplate = applyTemplateTokens(customCheckoutScriptTemplate, bundlePrice, regularTotal).trim();
        if (!processedTemplate) {
          window.location.href = shopRoot + 'checkout';
          return;
        }

        const looksLikeUrl = /^(https?:\/\/|\/)/i.test(processedTemplate) && !/[\n;{}]/.test(processedTemplate);
        if (looksLikeUrl) {
          window.location.href = processedTemplate;
          return;
        }

        const payload = {
          shopUrl,
          shopRoot,
          checkoutUrl: shopRoot + 'checkout',
          cartUrl: shopRoot + 'cart',
          bundleTotal: bundlePrice / 100,
          regularTotal: regularTotal / 100,
          discountPercent: 0,
          bundleSize: selectedItems.length,
          variantIds: selectedItems.map((item) => item.variantId),
          selectedItems: selectedItems.map((item) => ({ ...item })),
          currentOffer: null
        };

        window.discountBundleCheckout = payload;

        const executeCheckout = new Function(
          'payload',
          'window',
          'document',
          processedTemplate
        );

        executeCheckout(payload, window, document);
      };

      cards.forEach(bindCardInteractions);

      if (loadMoreButton) {
        loadMoreButton.addEventListener('click', loadMoreProducts);
        setLoadMoreState(loadMoreButton.dataset.nextUrl || '');
        updatePaginationText();
      }

      modalOptions.addEventListener('click', (event) => {
        const option = event.target.closest('[data-option-index]');
        if (!option || option.disabled) return;

        const optionIndex = option.dataset.optionIndex;
        const optionValue = option.dataset.optionValue;
        modalSelection['option' + optionIndex] = optionValue;
        syncModalSelectionUi();
      });

      modalSubmit.addEventListener('click', () => {
        if (!modalContext || !pendingVariant) return;

        commitSelection({
          productId: Number(modalContext.dataset.productId),
          productTitle: modalContext.dataset.productTitle,
          image: modalContext.dataset.productImage,
          variantId: pendingVariant.id,
          variantTitle: getVariantDisplayTitle(pendingVariant),
          price: Number(pendingVariant.price || 0)
        });

        closeModal();
      });

      modalCloseButtons.forEach((button) => {
        button.addEventListener('click', closeModal);
      });

      selectedList.addEventListener('click', (event) => {
        const removeButton = event.target.closest('[data-remove-line]');
        if (!removeButton) return;

        const removeIndex = selectedItems.findIndex((item) => item.lineId === removeButton.dataset.removeLine);
        if (removeIndex === -1) return;

        selectedItems.splice(removeIndex, 1);
        syncCards();
        renderSelected();
        updateSummary();
      });

      submitButton.addEventListener('click', async () => {
        if (!selectedItems.length) return;

        submitButton.disabled = true;
        submitButton.textContent = 'Loading...';

        try {
          const response = await fetch(shopRoot + 'cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json'
            },
            body: JSON.stringify({
              items: Array.from(selectedItems.reduce((lines, item) => {
                const line = lines.get(item.variantId) || { ...item, quantity: 0 };
                line.quantity += 1;
                lines.set(item.variantId, line);
                return lines;
              }, new Map()).values()).map((item) => ({
                id: item.variantId,
                quantity: item.quantity,
                properties: {
                  _bundle_source: 'discount-bundle-app'
                }
              }))
            })
          });

          if (!response.ok) {
            throw new Error('Bundle add failed');
          }

          const regularTotal = selectedItems.reduce((sum, item) => sum + item.price, 0);
          const bundlePrice = regularTotal;

          resetSelection();

          if (checkoutMode === 'custom') {
            runCustomCheckout(bundlePrice, regularTotal);
            return;
          }

          window.location.href = shopRoot + 'checkout';
        } catch (error) {
          submitButton.disabled = false;
          submitButton.textContent = getCheckoutButtonLabel();
          progressText.textContent = 'Something went wrong while preparing the bundle. Please try again.';
        }
      });

      parseBundleTiers();
      renderSelected();
      syncCards();
      updateSummary();
    })();
  </script>
</section>

{% schema %}
{
  "name": "Bundle template 1",
  "target": "section",
  "settings": [
    {
      "type": "collection",
      "id": "bundle_collection",
      "label": "Bundle collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your quantity bundle"
    },
    {
      "type": "text",
      "id": "sidebar_heading",
      "label": "Sidebar heading",
      "default": "Your bundle"
    },
    {
      "type": "checkbox",
      "id": "one_per_variant",
      "label": "Allow only one of each variant",
      "default": false,
      "info": "When disabled, shoppers can add any quantity of the same variant. Bundle quantities and discounts are configured in the Discount Bundle app."
    },
    { "type": "header", "content": "Bundle offers" },
    { "type": "paragraph", "content": "Set these to the same quantities and discounts created in Discount Bundle. Enable the offers you want shoppers to see." },
    { "type": "checkbox", "id": "bundle_offer_1_enabled", "label": "Enable offer 1", "default": true },
    { "type": "range", "id": "bundle_offer_1_quantity", "label": "Offer 1: number of items", "min": 2, "max": 50, "step": 1, "default": 2 },
    { "type": "select", "id": "bundle_offer_1_type", "label": "Offer 1: discount type", "default": "percentage", "options": [{ "value": "percentage", "label": "Percentage off" }, { "value": "fixed_price", "label": "Fixed total bundle price" }] },
    { "type": "number", "id": "bundle_offer_1_value", "label": "Offer 1: percentage or fixed price", "default": 10 },
    { "type": "checkbox", "id": "bundle_offer_2_enabled", "label": "Enable offer 2", "default": true },
    { "type": "range", "id": "bundle_offer_2_quantity", "label": "Offer 2: number of items", "min": 2, "max": 50, "step": 1, "default": 3 },
    { "type": "select", "id": "bundle_offer_2_type", "label": "Offer 2: discount type", "default": "percentage", "options": [{ "value": "percentage", "label": "Percentage off" }, { "value": "fixed_price", "label": "Fixed total bundle price" }] },
    { "type": "number", "id": "bundle_offer_2_value", "label": "Offer 2: percentage or fixed price", "default": 15 },
    { "type": "checkbox", "id": "bundle_offer_3_enabled", "label": "Enable offer 3", "default": false },
    { "type": "range", "id": "bundle_offer_3_quantity", "label": "Offer 3: number of items", "min": 2, "max": 50, "step": 1, "default": 4 },
    { "type": "select", "id": "bundle_offer_3_type", "label": "Offer 3: discount type", "default": "percentage", "options": [{ "value": "percentage", "label": "Percentage off" }, { "value": "fixed_price", "label": "Fixed total bundle price" }] },
    { "type": "number", "id": "bundle_offer_3_value", "label": "Offer 3: percentage or fixed price", "default": 20 },
    { "type": "checkbox", "id": "bundle_offer_4_enabled", "label": "Enable offer 4", "default": false },
    { "type": "range", "id": "bundle_offer_4_quantity", "label": "Offer 4: number of items", "min": 2, "max": 50, "step": 1, "default": 5 },
    { "type": "select", "id": "bundle_offer_4_type", "label": "Offer 4: discount type", "default": "percentage", "options": [{ "value": "percentage", "label": "Percentage off" }, { "value": "fixed_price", "label": "Fixed total bundle price" }] },
    { "type": "number", "id": "bundle_offer_4_value", "label": "Offer 4: percentage or fixed price", "default": 25 },
    {
      "type": "select",
