{%- liquid
  assign bundle_collection = block.settings.bundle_collection
  assign bundle_collection_handle = bundle_collection.handle
  assign bundle_collection_source = bundle_collection
  if bundle_collection_handle != blank
    assign bundle_collection_source = collections[bundle_collection_handle]
  endif
  assign checkout_mode = block.settings.checkout_mode | default: 'shopify'
  assign shopify_checkout_label = block.settings.shopify_checkout_label | default: 'Checkout securely'
  capture bundle_tiers
    echo '['
    for offer_index in (1..4)
      assign offer_enabled_key = 'bundle_offer_' | append: offer_index | append: '_enabled'
      assign offer_quantity_key = 'bundle_offer_' | append: offer_index | append: '_quantity'
      assign offer_type_key = 'bundle_offer_' | append: offer_index | append: '_type'
      assign offer_value_key = 'bundle_offer_' | append: offer_index | append: '_value'
      echo '{"enabled":'
      echo block.settings[offer_enabled_key] | json
      echo ',"quantity":'
      echo block.settings[offer_quantity_key] | json
      echo ',"discountType":'
      echo block.settings[offer_type_key] | json
      echo ',"value":'
      echo block.settings[offer_value_key] | json
      echo '}'
      unless forloop.last
        echo ','
      endunless
    endfor
    echo ']'
  endcapture
  assign bundle_image = block.settings.bundle_image
-%}

<section
  class="bundle-collection bundle-collection--{{ block.id }}"
  data-bundle-collection
  data-section-id="{{ block.id }}"
  data-currency-code="{{ cart.currency.iso_code | default: shop.currency }}"
  data-shop-root="{{ routes.root_url }}"
  data-shop-url="{{ shop.url }}"
  data-checkout-mode="{{ checkout_mode }}"
  data-shopify-checkout-label="{{ shopify_checkout_label | escape }}"
  data-checkout-label="{{ block.settings.custom_checkout_label | escape }}"
  data-custom-checkout-script="{{ block.settings.custom_checkout_url | escape }}"
  data-one-per-variant="{{ block.settings.one_per_variant }}"
  data-bundle-tiers="{{ bundle_tiers | strip_newlines | escape }}"
  data-total-products="{{ bundle_collection_source.products_count }}"
>
  <div class="bundle-collection__shell page-width">
    <div class="bundle-collection__products">
      <div class="bundle-collection__header">
        {%- if block.settings.eyebrow != blank -%}
          <p class="bundle-collection__eyebrow">{{ block.settings.eyebrow }}</p>
        {%- endif -%}

        <h2 class="bundle-collection__title">{{ block.settings.heading }}</h2>

        {%- if bundle_image != blank -%}
          <div class="bundle-collection__header-media">
            {{
              bundle_image
              | image_url: width: 900
              | image_tag:
                class: 'bundle-collection__header-image',
                widths: '360, 540, 720, 900',
                loading: 'lazy',
                alt: bundle_image.alt | default: block.settings.heading
            }}
          </div>
        {%- endif -%}

      </div>

      {%- if bundle_collection_source != blank and bundle_collection_source.products_count > 0 -%}
        {%- paginate bundle_collection_source.products by 250 -%}
        <div class="bundle-collection__grid">
          {%- for product in bundle_collection_source.products -%}
            {%- assign default_variant = product.selected_or_first_available_variant -%}
            {%- assign featured_image = product.featured_image | image_url: width: 800 -%}
            {%- assign has_multiple_variants = false -%}
            {%- assign featured_image_alt = product.featured_image.alt | default: product.title -%}
            {%- if product.has_only_default_variant == false and product.variants.size > 1 -%}
              {%- assign has_multiple_variants = true -%}
            {%- endif -%}

            <article
              class="bundle-collection__card"
              data-bundle-card
              data-product-id="{{ product.id }}"
              data-product-title="{{ product.title | escape }}"
              data-product-handle="{{ product.handle }}"
              data-product-url="{{ product.url }}"
              data-product-image="{{ featured_image }}"
              data-default-variant-id="{{ default_variant.id }}"
              data-default-variant-title="{{ default_variant.title | default: 'Default title' | escape }}"
              data-default-price="{{ default_variant.price }}"
              data-has-multiple-variants="{{ has_multiple_variants }}"
              data-product-available="{{ product.available }}"
            >
              <div class="bundle-collection__card-media">
                <a class="bundle-collection__card-link" href="{{ product.url }}">
                  {%- if product.featured_image != blank -%}
                    {{
                      product.featured_image
                      | image_url: width: 800
                      | image_tag:
                        class: 'bundle-collection__card-image',
                        widths: '320, 480, 640, 800',
                        loading: 'lazy',
                        alt: featured_image_alt
                    }}
                  {%- else -%}
                    <div class="bundle-collection__card-placeholder"></div>
                  {%- endif -%}
                </a>

                {%- if product.available -%}
                  <span class="bundle-collection__card-badge">{{ block.settings.Product_label }}</span>
                {%- else -%}
                  <span class="bundle-collection__card-badge bundle-collection__card-badge--sold-out">Out of stock</span>
                {%- endif -%}
              </div>

              <div class="bundle-collection__card-body">
                <a class="bundle-collection__card-title" href="{{ product.url }}">{{ product.title | truncate: 24 }}</a>

                <div class="bundle-collection__card-price-row">
                  <span class="bundle-collection__card-price">{{ default_variant.price | money }}</span>

                  {%- if default_variant.compare_at_price > default_variant.price -%}
                    <span class="bundle-collection__card-compare">{{ default_variant.compare_at_price | money }}</span>
                  {%- endif -%}
                </div>

                {%- if has_multiple_variants -%}
                  <p class="bundle-collection__card-meta">
                    {{ product.variants.size }} variants available
                  </p>
                {%- endif -%}

                <div class="bundle-collection__card-footer">
                  <button
                    type="button"
                    class="bundle-collection__card-toggle"
                    data-card-toggle
                    aria-pressed="false"
                    {% unless product.available %}disabled aria-disabled="true"{% endunless %}
                  >
                    {%- if has_multiple_variants -%}
                      Choose options
                    {%- else -%}
                      Add to bundle
                    {%- endif -%}
                  </button>
                </div>
              </div>

              <script type="application/json" data-product-options>
                {{ product.options | json }}
              </script>
              <script type="application/json" data-product-variants>
                [
                  {%- for variant in product.variants -%}
                    {
                      "id": {{ variant.id | json }},
                      "title": {{ variant.title | json }},
                      "available": {{ variant.available | json }},
                      "price": {{ variant.price | json }},
                      "option1": {{ variant.option1 | json }},
                      "option2": {{ variant.option2 | json }},
                      "option3": {{ variant.option3 | json }}
                    }{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                ]
              </script>
            </article>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <div class="bundle-collection__pagination" data-pagination>
            <p class="bundle-collection__pagination-copy">
              Showing {{ paginate.current_offset | plus: 1 }}-{{ paginate.current_offset | plus: paginate.page_size | at_most: paginate.items }} of {{ paginate.items }} products.
            </p>

            {%- if paginate.next -%}
              <button
                type="button"
                class="bundle-collection__pagination-link"
                data-load-more
                data-next-url="{{ paginate.next.url | escape }}"
              >
                Load more products
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <div class="bundle-collection__empty">
          Choose a collection in the app block settings to use this block on a bundle page.
        </div>
      {%- endif -%}
    </div>

    <aside class="bundle-collection__summary">
      <div class="bundle-collection__summary-card">
        <h3 class="bundle-collection__summary-title">{{ block.settings.sidebar_heading }}</h3>

        <div class="bundle-collection__offers" data-offer-options aria-label="Bundle offers"></div>

        <div class="bundle-collection__status" data-bundle-status>
          Select the products and quantities you want in your bundle.
        </div>

        <div class="bundle-collection__progress">
          <p class="bundle-collection__progress-text" data-progress-text>
            Your discount is calculated from the active bundle discount at checkout.
          </p>
        </div>

        <div class="bundle-collection__selected" data-selected-list>
          <div class="bundle-collection__selected-empty">Your selected products will appear here.</div>
        </div>

        <div class="bundle-collection__totals">
          <div class="bundle-collection__total-row">
            <span>Subtotal</span>
            <strong data-regular-total>{{ 0 | money }}</strong>
          </div>

        </div>

        <button
          type="button"
          class="bundle-collection__cta"
          data-bundle-submit
          disabled
        >
          {{ shopify_checkout_label }}
        </button>

      </div>
    </aside>
  </div>

  <div class="bundle-collection__modal" data-variant-modal hidden>
    <div class="bundle-collection__modal-backdrop" data-modal-close></div>

    <div
      class="bundle-collection__modal-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="bundle-modal-title-{{ block.id }}"
    >
      <button type="button" class="bundle-collection__modal-close" data-modal-close aria-label="Close">x</button>

      <p class="bundle-collection__modal-eyebrow">Select variant</p>
      <div class="bundle-collection__modal-product">
        <div class="bundle-collection__modal-media">
          <img class="bundle-collection__modal-image" data-modal-product-image alt="">
        </div>

        <div class="bundle-collection__modal-copy">
          <h3 id="bundle-modal-title-{{ block.id }}" class="bundle-collection__modal-title" data-modal-product-title></h3>
          <p class="bundle-collection__modal-price" data-modal-product-price></p>
        </div>
      </div>
      <div class="bundle-collection__modal-options" data-modal-options></div>

      <button type="button" class="bundle-collection__modal-submit" data-modal-submit disabled>
        Add to bundle
      </button>
    </div>
  </div>


  <style>.bundle-collection {--bundle-bg:{{ block.settings.background_color }};--bundle-card:{{ block.settings.card_color }};--bundle-text:{{ block.settings.text_color }};--bundle-muted:{{ block.settings.muted_text_color }};--bundle-accent:{{ block.settings.accent_color }};--bundle-accent-soft:{{ block.settings.accent_soft_color }};--bundle-border:{{ block.settings.border_color }};--bundle-shadow:0 20px 60px rgba(17,24,39,0.08);background:transparent;color:var(--bundle-text);padding:36px 16px} .bundle-collection__card-badge {position:absolute;left:12px;bottom:12px;background:#0a8a16;color:#fff;border-radius:2px;padding:6px 10px;font-size:12px;line-height:1;font-weight:500;text-transform:uppercase} .bundle-collection__card-media {position:relative;padding:0;background:#fff} .bundle-collection__shell {display:grid;grid-template-columns:minmax(0,1.6fr) minmax(320px,410px);gap:24px;align-items:start} .bundle-collection__header {margin-bottom:24px} .bundle-collection__header-media {margin:14px 0 0} .bundle-collection__header-image {display:block;width:100%;height:auto;border-radius:16px;object-fit:cover} .bundle-collection__eyebrow,.bundle-collection__modal-eyebrow {margin:0 0 6px;font-size:12px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:var(--bundle-accent)} .bundle-collection__title,.bundle-collection__summary-title,.bundle-collection__modal-title {margin:0;color:var(--bundle-text);line-height:1.08} .bundle-collection__title {font-size:32px;margin:0 0 6px} .bundle-collection__summary-title,.bundle-collection__modal-title {font-size:24px} .bundle-collection__summary-copy,.bundle-collection__fineprint {color:var(--bundle-muted);font-size:14px;line-height:1.5} .bundle-collection__summary-copy {margin:8px 0 0} .bundle-collection__offers {display:grid;gap:10px;margin:18px 0 14px} .bundle-collection__offer-option {display:flex;align-items:center;gap:10px;padding:7px 14px;border:1px solid var(--bundle-border);border-radius:14px;background:#fff;cursor