    { "type": "select", "id": "offer_type", "label": "Offer type", "default": "percentage", "options": [{ "value": "percentage", "label": "Percentage off" }, { "value": "fixed", "label": "Fixed bundle price" }] },
    { "type": "range", "id": "percent_off", "label": "Percentage off", "min": 1, "max": 100, "step": 1, "default": 20 },
    { "type": "number", "id": "fixed_bundle_price", "label": "Fixed bundle price", "default": 999, "info": "Used when Offer type is Fixed bundle price. Enter the price in your store currency." },
    { "type": "textarea", "id": "discount_detail", "label": "Discount information", "default": "Your configured bundle offer is shown before checkout. Shopify calculates the final eligible discount securely in cart and checkout." },
    { "type": "select", "id": "checkout_mode", "label": "Checkout mode", "default": "shopify", "options": [{ "value": "shopify", "label": "Shopify checkout" }, { "value": "custom", "label": "Custom GoKwik / Shiprocket checkout" }] },
    { "type": "text", "id": "shopify_button_label", "label": "Shopify button label", "default": "Checkout securely" },
    { "type": "text", "id": "custom_button_label", "label": "Custom checkout button label", "default": "Continue to secure checkout" },
    { "type": "textarea", "id": "custom_checkout_url", "label": "Custom provider URL", "info": "Optional. Runs after bundle items are added. You may use {{checkout_url}}, {{cart_url}}, {{shop_url}}, {{variant_ids}}, and {{bundle_total}}." },
    { "type": "textarea", "id": "custom_checkout_code", "label": "Custom provider code", "info": "Optional provider-approved GoKwik or Shiprocket browser code. It runs only after items are added to Shopify cart. Do not paste private API keys." },
    { "type": "text", "id": "custom_checkout_note", "label": "Custom checkout note", "default": "You will continue to our secure checkout partner." },
    { "type": "text", "id": "summary_heading", "label": "Summary heading", "default": "Your bundle" },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 4, "max": 50, "step": 1, "default": 16 }
  ]
}
