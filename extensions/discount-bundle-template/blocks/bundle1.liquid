:0} #discount-bundle-{{ block.id }} .discount-bundle__remove::after {content:'\00d7';font-size:15px;line-height:18px} #discount-bundle-{{ block.id }} .discount-bundle__price-box {display:grid;gap:5px;min-width:220px;margin:0;padding:0;border:0} #discount-bundle-{{ block.id }} .discount-bundle__price-box div {display:flex;justify-content:space-between;gap:12px;font-size:14px} #discount-bundle-{{ block.id }} .discount-bundle__price-box span {color:var(--db-muted)} #discount-bundle-{{ block.id }} .discount-bundle__saving strong {color:var(--db-accent)} #discount-bundle-{{ block.id }} .discount-bundle__bundle-total {font-size:17px !important} #discount-bundle-{{ block.id }} .discount-bundle__discount-detail {padding:11px;margin-bottom:14px;border-radius:9px;background:var(--db-accent-soft);color:var(--db-accent);font-size:12px;line-height:1.45} #discount-bundle-{{ block.id }} .discount-bundle__checkout {background:var(--db-accent);color:#fff;min-height:56px} #discount-bundle-{{ block.id }} .discount-bundle__checkout:disabled {cursor:not-allowed;opacity:.45} #discount-bundle-{{ block.id }} .discount-bundle__modal[hidden] {display:none} #discount-bundle-{{ block.id }} .discount-bundle__modal {position:fixed;z-index:1000;inset:0;display:grid;place-items:center;padding:20px} #discount-bundle-{{ block.id }} .discount-bundle__modal-backdrop {position:absolute;inset:0;background:rgba(8,12,20,.58)} #discount-bundle-{{ block.id }} .discount-bundle__modal-dialog {position:relative;z-index:1;display:grid;grid-template-columns:minmax(180px,.9fr) minmax(260px,1.1fr);width:min(680px,100%);max-height:min(720px,90vh);overflow:auto;background:var(--db-card);border-radius:18px;color:var(--db-text)} #discount-bundle-{{ block.id }} .discount-bundle__modal-image {width:100%;height:100%;min-height:280px;object-fit:cover;background:var(--db-background)} #discount-bundle-{{ block.id }} .discount-bundle__modal-copy {padding:28px} #discount-bundle-{{ block.id }} .discount-bundle__modal-copy h3 {font-size:25px;margin-bottom:18px} #discount-bundle-{{ block.id }} .discount-bundle__modal-close {position:absolute;top:10px;right:10px;z-index:2;width:35px;height:35px;border:0;border-radius:50%;background:rgba(255,255,255,.94);color:#111;cursor:pointer;font-size:25px;line-height:1} #discount-bundle-{{ block.id }} .discount-bundle__option {margin:14px 0} #discount-bundle-{{ block.id }} .discount-bundle__option label {display:block;margin-bottom:6px;font-size:13px;font-weight:800} #discount-bundle-{{ block.id }} .discount-bundle__option select {width:100%;min-height:42px;padding:8px;border:1px solid var(--db-border);border-radius:8px;background:var(--db-card);color:var(--db-text)} #discount-bundle-{{ block.id }} .discount-bundle__modal-price {margin:18px 0;font-size:18px;font-weight:800} #discount-bundle-{{ block.id }}.discount-bundle--empty {padding:20px;text-align:center} @media (max-width:900px) {#discount-bundle-{{ block.id }} {padding-bottom:230px} #discount-bundle-{{ block.id }} .discount-bundle__summary {grid-template-columns:1fr auto;gap:12px;padding:12px 16px} #discount-bundle-{{ block.id }} .discount-bundle__price-box {display:none} #discount-bundle-{{ block.id }} .discount-bundle__summary-note {right:16px}} @media (max-width:620px) {#discount-bundle-{{ block.id }} {padding-left:14px;padding-right:14px;padding-bottom:245px} #discount-bundle-{{ block.id }} .discount-bundle__hero {padding:22px;border-radius:16px} #discount-bundle-{{ block.id }} .discount-bundle__grid {grid-template-columns:repeat(2,minmax(0,1fr));gap:10px} #discount-bundle-{{ block.id }} .discount-bundle__card-content {padding:10px} #discount-bundle-{{ block.id }} .discount-bundle__card h4 {font-size:13px} #discount-bundle-{{ block.id }} .discount-bundle__summary {grid-template-columns:1fr;padding:10px 14px} #discount-bundle-{{ block.id }} .discount-bundle__selected-item {min-width:150px} #discount-bundle-{{ block.id }} .discount-bundle__summary-note {top:-27px;font-size:11px} #discount-bundle-{{ block.id }} .discount-bundle__checkout {min-height:46px} #discount-bundle-{{ block.id }} .discount-bundle__modal-dialog {grid-template-columns:1fr} #discount-bundle-{{ block.id }} .discount-bundle__modal-image {min-height:180px;max-height:260px}}</style>

<style>
  #discount-bundle-{{ block.id }} .discount-bundle__sold-out {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 1;
    border-radius: 999px;
    background: #b42318;
    color: #fff;
    padding: 6px 9px;
    font-size: 11px;
    font-weight: 800;
  }

  #discount-bundle-{{ block.id }} .discount-bundle__card:has(.discount-bundle__sold-out) {
    opacity: .68;
  }

  #discount-bundle-{{ block.id }} .discount-bundle__add:disabled {
    cursor: not-allowed;
    opacity: .5;
    transform: none;
  }
</style>

<script>
  (() => {
    const section = document.getElementById('discount-bundle-{{ block.id }}');
    if (!section || section.dataset.initialized === 'true') return;
    section.dataset.initialized = 'true';

    const moneyFormat = {{ cart.currency.symbol | default: shop.money_format | json }};
    const currency = {{ cart.currency.iso_code | default: shop.currency | json }};
    const onePerVariant = section.dataset.onePerVariant === 'true';
    let bundleTiers = [];
    const shopRoot = section.dataset.shopRoot || '/';
    const selected = [];
    let modalCard = null;
    let modalVariants = [];

    const grid = section.querySelector('[data-product-grid]');
    const selectedItems = section.querySelector('[data-selected-items]');
    const counter = section.querySelector('[data-counter]');
    const progress = section.querySelector('[data-progress]');
    const progressCopy = section.querySelector('[data-progress-copy]');
    const regularTotal = section.querySelector('[data-regular-total]');
    const saving = section.querySelector('[data-saving]');
    const bundleTotal = section.querySelector('[data-bundle-total]');
    const checkout = section.querySelector('[data-checkout]');
    const modal = section.querySelector('[data-variant-modal]');
    const modalTitle = section.querySelector('[data-modal-title]');
    const modalImage = section.querySelector('[data-modal-image]');
    const modalOptions = section.querySelector('[data-modal-options]');
    const modalPrice = section.querySelector('[data-modal-price]');
    const modalAdd = section.querySelector('[data-modal-add]');

    const formatMoney = (cents) => {
      try { return new Intl.NumberFormat(undefined, { style: 'currency', currency }).format((Number(cents) || 0) / 100); }
      catch (error) { return moneyFormat.replace('{{amount}}', ((Number(cents) || 0) / 100).toFixed(2)); }
    };
    const escapeHtml = (value) => String(value || '').replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;' })[character]);
    const getSubtotal = () => selected.reduce((total, item) => total + item.price, 0);
    const parseBundleTiers = () => {
      try {
        bundleTiers = JSON.parse(section.dataset.bundleTiers || '[]')
          .filter((tier) => tier && tier.enabled !== false)
          .map((tier) => ({ quantity: Number(tier.quantity), discountType: tier.discountType === 'fixed_price' ? 'fixed_price' : 'percentage', value: Number(tier.value) }))
          .filter((tier) => Number.isInteger(tier.quantity) && tier.quantity >= 2 && tier.value > 0)
          .sort((left, right) => left.quantity - right.quantity);
      } catch (error) { bundleTiers = []; }
    };
    const getBundleLimit = () => bundleTiers.length ? Math.max(...bundleTiers.map((tier) => tier.quantity)) : Infinity;
    const getQualifiedTier = () => bundleTiers.filter((tier) => selected.length >= tier.quantity).at(-1) || null;
    const getTierLabel = (tier) => tier.discountType === 'fixed_price'
      ? 'Buy ' + tier.quantity + ' for ' + formatMoney(tier.value * 100)
      : 'Buy ' + tier.quantity + ' and save ' + tier.value + '%';
    const getDiscount = () => {
      const tier = getQualifiedTier();
      if (!tier) return 0;
      const subtotal = getSubtotal();
      return tier.discountType === 'fixed_price' ? Math.max(0, subtotal - tier.value * 100) : Math.round(subtotal * tier.value / 100);
    };
    const getTotal = () => Math.max(0, getSubtotal() - getDiscount());
    const chosenVariant = () => {
      const values = [...modalOptions.querySelectorAll('select')].map((select) => select.value);
      return modalVariants.find((variant) => variant.available && values.every((value, index) => !value || variant['option' + (index + 1)] === value)) || null;
    };

    const render = () => {
      const subtotal = getSubtotal();
      const discount = getDiscount();
      const qualifiedTier = getQualifiedTier();
      counter.textContent = selected.length + ' / ' + (Number.isFinite(getBundleLimit()) ? getBundleLimit() : '∞');
      progress.textContent = selected.length + ' selected';
      regularTotal.textContent = formatMoney(subtotal);
      saving.textContent = '-' + formatMoney(discount);
      bundleTotal.textContent = formatMoney(getTotal());
      progressCopy.textContent = qualifiedTier
        ? getTierLabel(qualifiedTier) + ' selected. Continue to checkout.'
        : 'Add products until you qualify for one of the configured offers.';
      checkout.disabled = !qualifiedTier;
      selectedItems.innerHTML = selected.length ? selected.map((item, index) => `
        <div class="discount-bundle__selected-item">
          <img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.title)}">
          <span><strong>${escapeHtml(item.title)}</strong><small>${escapeHtml(item.variantTitle)}</small></span>
          <button type="button" class="discount-bundle__remove" data-remove="${index}">Remove</button>
        </div>`).join('') : '<div class="discount-bundle__empty">Your chosen products will appear here.</div>';
      grid.querySelectorAll('[data-product-card]').forEach((card) => {
        const button = card.querySelector('[data-add-product]');
        const selectedCount = selected.filter((item) => String(item.productId) === card.dataset.productId).length;
        card.classList.toggle('is-selected', selectedCount > 0);
        if (!button || card.dataset.productAvailable !== 'true') return;
        if (selected.length >= getBundleLimit()) { button.textContent = 'Bundle full'; button.disabled = true; return; }
        button.disabled = onePerVariant && card.dataset.hasSingleVariant === 'true' && selectedCount > 0;
        button.textContent = selectedCount ? '+ Add one more' : (card.dataset.hasMultipleVariants === 'true' ? 'Choose options' : 'Add to bundle');
      });
    };

    const addVariant = (card, variant) => {
      if (!variant || !variant.available || selected.length >= getBundleLimit()) return;
      if (onePerVariant && selected.some((item) => String(item.variantId) === String(variant.id))) return;
      selected.push({ productId: card.dataset.productId, title: card.dataset.title, image: variant.featured_image?.src || card.dataset.image, variantId: variant.id, variantTitle: variant.public_title || variant.title || 'Default', price: Number(variant.price || 0) });
      closeModal();
      render();
    };
    const closeModal = () => { modal.hidden = true; modalCard = null; modalVariants = []; modalOptions.innerHTML = ''; };
    const renderModal = () => {
      const firstVariant = chosenVariant() || modalVariants.find((variant) => variant.available) || null;
      modalAdd.disabled = !firstVariant;
      modalPrice.textContent = firstVariant ? formatMoney(firstVariant.price) : 'This option is unavailable';
      modalAdd.dataset.variantId = firstVariant?.id || '';
    };
    const openModal = (card, variants) => {
      modalCard = card;
      modalVariants = variants;
      modalTitle.textContent = card.dataset.title;
      modalImage.src = card.dataset.image;
      modalImage.alt = card.dataset.title;
      const optionNames = ['option1', 'option2', 'option3'];
      modalOptions.innerHTML = optionNames.map((key, index) => {
        const values = [...new Set(variants.map((variant) => variant[key]).filter(Boolean))];
        if (!values.length) return '';
        return `<div class="discount-bundle__option"><label for="db-option-${index}">${escapeHtml(variants[0]['option' + (index + 1) + '_name'] || 'Option ' + (index + 1))}</label><select id="db-option-${index}" data-option-select>${values.map((value) => `<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`).join('')}</select></div>`;
      }).join('');
      modalOptions.querySelectorAll('[data-option-select]').forEach((select) => select.addEventListener('change', renderModal));
      modal.hidden = false;
      renderModal();
    };

    grid.addEventListener('click', (event) => {
      const button = event.target.closest('[data-add-product]');
      if (!button || selected.length >= getBundleLimit()) return;
      const card = button.closest('[data-product-card]');
      if (card.dataset.productAvailable !== 'true') return;
      let variants = [];
      try { variants = JSON.parse(card.querySelector('[data-variants]').textContent); } catch (error) { return; }
      const available = variants.filter((variant) => variant.available);
      if (!available.length) return;
      if (available.length === 1) addVariant(card, available[0]); else openModal(card, variants);
    });
    selectedItems.addEventListener('click', (event) => { const remove = event.target.closest('[data-remove]'); if (!remove) return; selected.splice(Number(remove.dataset.remove), 1); render(); });
    section.querySelectorAll('[data-modal-close]').forEach((button) => button.addEventListener('click', closeModal));
    modalAdd.addEventListener('click', () => { const variant = modalVariants.find((item) => String(item.id) === modalAdd.dataset.variantId); addVariant(modalCard, variant); });

    const replaceTokens = (value) => String(value || '').replaceAll('{{shop_url}}', window.location.origin).replaceAll('{{cart_url}}', shopRoot + 'cart').replaceAll('{{checkout_url}}', shopRoot + 'checkout').replaceAll('{{variant_ids}}', selected.map((item) => item.variantId).join(',')).replaceAll('{{bundle_total}}', String(getTotal() / 100));
    checkout.addEventListener('click', async () => {
      if (!getQualifiedTier()) return;
      checkout.disabled = true;
      try {
          const items = Array.from(selected.reduce((lines, item) => {
            const line = lines.get(item.variantId) || { id: item.variantId, quantity: 0 };
            line.quantity += 1;
            lines.set(item.variantId, line);
            return lines;
          }, new Map()).values()).map((item) => ({ ...item, properties: { _bundle_source: 'discount-bundle-app' } }));
          const response = await fetch(shopRoot + 'cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items }) });
        if (!response.ok) throw new Error('Unable to add the bundle');
        window.location.assign(shopRoot + 'checkout');
      } catch (error) { checkout.disabled = false; progressCopy.textContent = 'We could not add this bundle. Please try again.'; }
    });
    parseBundleTiers();
    render();
  })();
</script>

