{%- liquid
  assign bundle_collection = block.settings.bundle_collection
  capture bundle_tiers
    echo '['
    for offer_index in (1..4)
      assign offer_enabled_key = 'bundle_offer_' | append: offer_index | append: '_enabled'
      assign offer_quantity_key = 'bundle_offer_' | append: offer_index | append: '_quantity'
      assign offer_type_key = 'bundle_offer_' | append: offer_index | append: '_type'
      assign offer_value_key = 'bundle_offer_' | append: offer_index | append: '_value'
      echo '{"enabled":'
      echo block.settings[offer_enabled_key] | json
      echo ',"quantity":'
      echo block.settings[offer_quantity_key] | json
      echo ',"discountType":'
      echo block.settings[offer_type_key] | json
      echo ',"value":'
      echo block.settings[offer_value_key] | json
      echo '}'
      unless forloop.last
        echo ','
      endunless
    endfor
    echo ']'
  endcapture
-%}

{%- if bundle_collection != blank -%}
  <section
    id="discount-bundle-{{ block.id }}"
    class="discount-bundle"
    data-bundle-section
    data-bundle-tiers="{{ bundle_tiers | strip_newlines | escape }}"
    data-one-per-variant="{{ block.settings.one_per_variant }}"
    data-shop-root="{{ routes.root_url }}"
    style="--db-background: #f7f6f2; --db-card: #ffffff; --db-text: #17221e; --db-muted: #65706a; --db-accent: #176b4d; --db-accent-soft: #ddf1e8; --db-border: #dbe3dd;"
    {{ block.shopify_attributes }}
  >
    <div class="discount-bundle__shell">
      <header class="discount-bundle__hero">
        <div class="discount-bundle__hero-copy">
          {%- if block.settings.eyebrow != blank -%}<p class="discount-bundle__eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
          <h2>{{ block.settings.heading | default: 'Build your bundle' }}</h2>
          <div class="discount-bundle__offer" data-offer-copy>
            <span class="discount-bundle__offer-badge">Bundle saving</span>
            <strong>
              {%- if block.settings.offer_message != blank -%}
                {{ block.settings.offer_message }}
              {%- else -%}
                Configure your bundle offers in the app block settings.
              {%- endif -%}
            </strong>
          </div>
        </div>
      </header>

      <div class="discount-bundle__layout">
        <div>
          <div class="discount-bundle__section-heading">
            <div>
              <p class="discount-bundle__kicker">{{ bundle_collection.title }}</p>
              <h3>Choose your bundle products</h3>
            </div>
            <span class="discount-bundle__counter" data-counter>0 selected</span>
          </div>
          <div class="discount-bundle__grid" data-product-grid>
            {%- for product in bundle_collection.products limit: block.settings.product_limit -%}
              {%- assign available_variant = product.selected_or_first_available_variant -%}
              {%- if available_variant != blank -%}
                <article
                  class="discount-bundle__card"
                  data-product-card
                  data-product-id="{{ product.id }}"
                  data-title="{{ product.title | escape }}"
                  data-image="{{ product.featured_image | image_url: width: 700 }}"
                  data-product-available="{{ product.available }}"
                  data-has-multiple-variants="{% if product.variants.size > 1 %}true{% else %}false{% endif %}"
                  data-has-single-variant="{% if product.variants.size == 1 %}true{% else %}false{% endif %}"
                >
                  <div class="discount-bundle__image-wrap">
                    {%- if product.featured_image != blank -%}
                      {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '240, 360, 520, 700', class: 'discount-bundle__image', alt: product.title }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'discount-bundle__image discount-bundle__placeholder' }}
                    {%- endif -%}
                    {%- if product.variants.size > 1 -%}<span class="discount-bundle__variant-count">{{ product.variants.size }} options</span>{%- endif -%}
                    {%- unless product.available -%}<span class="discount-bundle__sold-out">Out of stock</span>{%- endunless -%}
                  </div>
                  <div class="discount-bundle__card-content">
                    <h4>{{ product.title }}</h4>
                    <p>{{ available_variant.price | money }}</p>
                    <button class="discount-bundle__add" type="button" data-add-product {% unless product.available %}disabled aria-disabled="true"{% endunless %}>
                      {%- if product.available == false -%}Out of stock{%- elsif product.variants.size > 1 -%}Choose options{%- else -%}Add to bundle{%- endif -%}
                    </button>
                  </div>
                  <script type="application/json" data-variants>{{ product.variants | json }}</script>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        <aside class="discount-bundle__summary" data-summary>
          <div class="discount-bundle__summary-heading">
            <div>
              <p class="discount-bundle__kicker">Your selection</p>
              <h3>{{ block.settings.summary_heading | default: 'Your bundle' }}</h3>
            </div>
            <span class="discount-bundle__progress" data-progress>0 selected</span>
          </div>
          <p class="discount-bundle__summary-note" data-progress-copy>Select products and quantities for your bundle.</p>
          <div class="discount-bundle__selected" data-selected-items></div>
          <div class="discount-bundle__price-box">
            <div><span>Items total</span><strong data-regular-total>{{ 0 | money }}</strong></div>
            <div class="discount-bundle__saving"><span>Bundle saving</span><strong data-saving>{{ 0 | money }}</strong></div>
            <div class="discount-bundle__bundle-total"><span>Bundle total</span><strong data-bundle-total>{{ 0 | money }}</strong></div>
          </div>
          <button type="button" class="discount-bundle__checkout" data-checkout disabled>
            {{ block.settings.shopify_button_label | default: 'Checkout securely' }}
          </button>
        </aside>
      </div>
    </div>

    <div class="discount-bundle__modal" data-variant-modal hidden>
      <div class="discount-bundle__modal-backdrop" data-modal-close></div>
      <div class="discount-bundle__modal-dialog" role="dialog" aria-modal="true" aria-labelledby="discount-bundle-modal-title-{{ block.id }}">
        <button class="discount-bundle__modal-close" type="button" aria-label="Close" data-modal-close>&times;</button>
        <img class="discount-bundle__modal-image" data-modal-image alt="">
        <div class="discount-bundle__modal-copy">
          <p class="discount-bundle__kicker">Select options</p>
          <h3 id="discount-bundle-modal-title-{{ block.id }}" data-modal-title></h3>
          <div data-modal-options></div>
          <p class="discount-bundle__modal-price" data-modal-price></p>
          <button class="discount-bundle__checkout discount-bundle__modal-add" type="button" data-modal-add>Add to bundle</button>
        </div>
      </div>
    </div>
  </section>
{%- else -%}
  <section class="discount-bundle discount-bundle--empty" {{ block.shopify_attributes }}>
    <p>Choose a collection in this Bundle app block's settings to display products.</p>
  </section>
{%- endif -%}

